<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="SweetShop Test Suite" parallel="tests" thread-count="2">
    <listeners>
        <listener class-name="listeners.TestListener"/>
        <listener class-name="listeners.RetryListener"/>
    </listeners>

    <test name="Login Module">
        <classes>
            <class name="tests.LoginTest"/>
        </classes>
    </test>

    <test name="Product Module">
        <classes>
            <class name="tests.ProductTest"/>
        </classes>
    </test>

    <test name="Basket Module">
        <classes>
            <class name="tests.BasketTest"/>
        </classes>
    </test>

    <test name="Account Module">
        <classes>
            <class name="tests.AccountTest"/>
        </classes>
    </test>

    <test name="Navigation Module">
        <classes>
            <class name="tests.NavigationTest"/>
        </classes>
    </test>
</suite>